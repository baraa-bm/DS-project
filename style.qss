QDialog {
    background-color: #f4f8ff;
    color: #172033;
    font-family: "Segoe UI";
}

QDialog#LoginDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1462f3, stop:1 #3627b9);
}

QFrame {
    background-color: #ffffff;
    border: 1px solid #edf2f7;
    border-radius: 10px;
}

QFrame#MediQueueFrame,
QFrame#SimulatorFrame,
QFrame#PatientsFrame,
QFrame#StatsFrame,
QFrame#NewPatient,
QFrame#Card {
    background-color: #ffffff;
    border: 1px solid #e7edf5;
    border-radius: 12px;
}

QFrame#Card {
    border-radius: 16px;
}

QFrame#DemoBox {
    background-color: #eef6ff;
    border: 1px solid #cfe1f5;
    border-radius: 8px;
}

QFrame#CrucialFrame,
QFrame#UrgentFrame,
QFrame#NormalFrame,
QFrame#TotalFrame {
    border: 0;
    border-radius: 8px;
}

QFrame#CrucialFrame {
    background-color: #fff1f3;
}

QFrame#UrgentFrame {
    background-color: #fff7ed;
}

QFrame#NormalFrame {
    background-color: #edfdf4;
}

QFrame#TotalFrame {
    background-color: #eef6ff;
    border: 1px solid #bfd7f4;
}

QLabel {
    background-color: transparent;
    border: 0;
    color: #172033;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 400;
}

QLabel#label {
    qproperty-text: "MediQueue Pro";
    color: #123a7a;
    font-size: 24px;
    font-weight: 800;
}

QLabel#label_3 {
    color: #123a7a;
    font-size: 12px;
}

QLabel#label_4,
QLabel#Subtitle,
QLabel#Footer,
QLabel#label_2 {
    color: #5b6472;
    font-size: 11px;
}

QLabel#label_4 {
    qproperty-alignment: AlignCenter;
}

QLabel#Footer {
    color: #ffffff;
}

QLabel#CurrentTime {
    color: #123a7a;
    font-size: 15px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

QLabel#TimeSimulator,
QLabel#label_5,
QLabel#QueueStatus {
    color: #172033;
    font-size: 14px;
    font-weight: 700;
}

QLabel#TimeSimulator {
    qproperty-text: "Time Simulator";
    color: #173f83;
}

QLabel#Title {
    color: #111827;
    font-size: 20px;
    font-weight: 700;
}

QLabel#FieldLabel {
    color: #111827;
    font-size: 11px;
    font-weight: 600;
}

QLabel#Message {
    min-height: 18px;
    font-size: 11px;
}

QLabel#DemoText {
    color: #173f68;
    font-size: 9px;
}

QLabel#LoginIcon {
    background-color: #145de8;
    border-radius: 12px;
    color: #ffffff;
    font-size: 28px;
    font-weight: 800;
}

QLabel#label_6,
QLabel#label_7,
QLabel#label_8,
QLabel#label_9 {
    color: #263242;
    font-size: 12px;
}

QLabel#CurcialNumber {
    color: #d11d37;
    font-weight: 800;
}

QLabel#UrgentNumber {
    color: #c46a17;
    font-weight: 800;
}

QLabel#NormaNumber {
    color: #149b57;
    font-weight: 800;
}

QLabel#TotaNumber {
    color: #1164d8;
    font-weight: 800;
}

QLineEdit {
    min-height: 30px;
    border: 1px solid #d6dbe3;
    border-radius: 7px;
    padding: 0 10px;
    background-color: #ffffff;
    color: #111827;
    font-size: 12px;
}

QLineEdit:focus {
    border: 1px solid #1f66f2;
}

QPushButton {
    min-height: 28px;
    border: 0;
    border-radius: 6px;
    padding: 2px 8px;
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 11px;
    font-weight: 700;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2884f7, stop:1 #1260ed);
}

QPushButton:hover {
    background: #155be2;
}

QPushButton:pressed {
    background: #0f47bd;
}

QPushButton#PrimaryButton {
    min-height: 32px;
    border-radius: 8px;
    font-size: 12px;
}

QPushButton#LinkButton {
    min-height: 18px;
    border: 0;
    color: #1155c8;
    background: transparent;
    font-weight: 700;
}

QPushButton#CrucialButton,
QPushButton#NormalButton,
QPushButton#UrgentButton {
    min-height: 48px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    background-color: #ffffff;
    color: #111827;
    font-size: 12px;
    font-weight: 600;
    padding: 4px;
}

QPushButton#NormalButton:hover {
    border: 2px solid #00c950;
}

QPushButton#NormalButton:checked {
    background-color: #f0fdf4;
    border: 2px solid #00c950;
    color: #00a746;
}

QPushButton#UrgentButton:hover {
    border: 2px solid #ff6900;
}

QPushButton#UrgentButton:checked {
    background-color: #fff7ed;
    border: 2px solid #ff6900;
    color: #d95a00;
}

QPushButton#CrucialButton:hover {
    border: 2px solid #fb2c36;
}

QPushButton#CrucialButton:checked {
    background-color: #fef2f2;
    border: 2px solid #fb2c36;
    color: #d11d37;
}

QPushButton#add5m {
    qproperty-text: "+ 5 min";
}

QPushButton#add15m {
    qproperty-text: "+ 15 min";
}

QPushButton#add30m {
    qproperty-text: "+ 30 min";
}

QPushButton#add1h {
    qproperty-text: "+ 1 hour";
}

QPushButton#close_checkIn {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    border-radius: 6px;
    padding: 0;
    font-size: 11px;
}

QListWidget {
    border: 1px solid #e6edf5;
    border-radius: 10px;
    background-color: #ffffff;
    color: #172033;
    font-size: 12px;
    font-weight: 600;
    outline: 0;
    padding: 8px;
}

QListWidget::item {
    min-height: 30px;
    border-radius: 7px;
    padding: 6px 10px;
    margin: 3px 0;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #123a7a;
}
